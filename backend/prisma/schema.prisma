generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  moduleFormat    = "commonjs"
}

datasource db {
  provider = "postgresql"
}

model User{
  id          String    @id @default(uuid()) 
  firstName   String  
  lastName    String
  email       String    @unique
  password    String?
  image       String?
  phoneNumber String?
  role        Role      @default(CUSTOMER)
  isVerified  Boolean   @default(false)  


  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt 

  addresses           Address[]
  refreshTokens       RefreshToken[] 
  account             Account[]
  Seller              Seller?
}

enum Role{
  CUSTOMER
  ADMIN
  SELLER
}

model Address{
  id        String    @id @default(uuid())
  label     String?   
  street    String
  city      String
  state     String
  country   String
  zipCode   String
  isDefault Boolean   @default(false) 

  userId    String
  user      User      @relation(fields:[userId] , references:[id] , onDelete:Cascade)  

  createdAt DateTime  @default(now())   
}

model RefreshToken{
  id          String     @id @default(uuid())
  token       String     @unique    
  expiredAt   DateTime
  isRevoked   Boolean    @default(false)
  replacedBy  String?

  userId      String
  user        User       @relation(fields:[userId] , references:[id] , onDelete:Cascade) 

  createdAt   DateTime   @default(now())       
}

model Account{
  id                  String    @id @default(uuid())
  provider            String    
  providerAccountId   String

  userId              String
  user                User      @relation(fields:[userId] , references : [id] , onDelete : Cascade)

  createdAt           DateTime  @default(now())

  @@unique([provider , providerAccountId])
}

model Seller{
  userId        String    @id
  user          User      @relation(fields:[userId] , references : [id] , onDelete : Cascade)
  storeName     String    
  storeSlug     String    @unique
  description   String
  logo          String
  status        SellerStatus  @default(PENDING)
}

enum SellerStatus{
  REJECTED
  PENDING
  APPROVED
}