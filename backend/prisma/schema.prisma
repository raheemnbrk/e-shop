generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  moduleFormat    = "commonjs"
}

datasource db {
  provider = "postgresql"
}

model User{
  id          String    @id @default(uuid()) 
  firstName   String  
  lastName    String
  email       String    @unique
  password    String?
  image       String?
  phoneNumber String?
  role        Role      @default(CUSTOMER)
  isVerified  Boolean   @default(false)  


  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt 

  addresses           Address[]
  refreshTokens       RefreshToken[] 
  account             Account[]
  Seller              Seller?
  reviews             Review[]
  cart                Cart?
}

enum Role{
  CUSTOMER
  ADMIN
  SELLER
}

model Address{
  id        String    @id @default(uuid())
  label     String?   
  street    String
  city      String
  state     String
  country   String
  zipCode   String
  isDefault Boolean   @default(false) 

  userId    String
  user      User      @relation(fields:[userId] , references:[id] , onDelete:Cascade)  

  createdAt DateTime  @default(now())   
}

model RefreshToken{
  id          String     @id @default(uuid())
  token       String     @unique    
  expiredAt   DateTime
  isRevoked   Boolean    @default(false)
  replacedBy  String?

  userId      String
  user        User       @relation(fields:[userId] , references:[id] , onDelete:Cascade) 

  createdAt   DateTime   @default(now())       
}

model Account{
  id                  String    @id @default(uuid())
  provider            String    
  providerAccountId   String

  userId              String
  user                User      @relation(fields:[userId] , references : [id] , onDelete : Cascade)

  createdAt           DateTime  @default(now())

  @@unique([provider , providerAccountId])
}

model Seller{
  userId        String    @id
  user          User      @relation(fields:[userId] , references : [id] , onDelete : Cascade)
  storeName     String    
  storeSlug     String    @unique
  description   String
  logo          String
  status        SellerStatus  @default(PENDING)

  products    Product[]
}

enum SellerStatus{
  REJECTED
  PENDING
  APPROVED
}

model Product{
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique 
  description     String 
  price           Float
  stock           Int      @default(0)
  discount        Int      @default(0)
  images          String[]
  available       Boolean  @default(true)

  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  sellerId       String
  seller         Seller   @relation(fields: [sellerId], references: [userId], onDelete: Cascade)

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt()  

  reviews         Review[] 
  cartItems       CartItem[]   
}

model Category {
  id            String     @id @default(uuid())
  name          String     @unique
  slug          String     @unique
  image         String?
  parentId      String?
  parent        Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children      Category[] @relation("CategoryTree")
  products      Product[]
  createdAt     DateTime   @default(now())
}

model Review {
  id        String   @id @default(uuid())
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade) // was [userId]

  @@unique([userId, productId])
}

model Cart {
  id        String      @id @default(uuid())
  userId    String      @unique  
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[] 
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model CartItem {
  id        String   @id @default(uuid())
  quantity  Int      @default(1)

  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade) 

  @@unique([cartId, productId]) 
}